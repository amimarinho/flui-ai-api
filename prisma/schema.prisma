generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaceCategory {
  ev_charging
  coffee
  gas_station
}

enum PlaceStatus {
  available
  busy
  unavailable
  maintenance
}

model Place {
  id           String        @id @default(uuid())
  name         String
  category     PlaceCategory
  latitude     Float
  longitude    Float
  address      String
  rating       Float
  status       PlaceStatus
  openingHours String
  powerKw      Int?
  connectors   Json          @default("[]")
}
